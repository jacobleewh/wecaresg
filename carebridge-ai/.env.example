# ---------------------------------------------------------------------------
# WeCareSG — environment configuration
# Copy this file to `.env`. Live triage requires a Gemini API key.
# Telegram is optional. Recommendations have no offline fallback.
# ---------------------------------------------------------------------------

# --- Flask session security --------------------------------------------------
# Required for citizen/case-worker login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Telegram Bot -----------------------------------------------------------
# Get a token from @BotFather on Telegram (see README setup steps).
TELEGRAM_BOT_TOKEN=

# "polling"  -> zero-config long-polling, works instantly on localhost.
# "webhook"  -> production mode; requires WEBHOOK_URL below (e.g. an ngrok
#               HTTPS URL or your deployed server's public HTTPS URL).
TELEGRAM_MODE=polling
WEBHOOK_URL=

# --- Live Gemini triage (required for recommendations) ----------------------
# Triage uses Gemini free-tier text generation with directly retrieved official pages (no paid Search tool).
# API failures are shown to the user; there is no offline recommendation fallback.
LLM_PROVIDER=gemini

GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# --- Live support locator (Singapore OneMap) -------------------------------
# Create a OneMap API token and keep it server-side. The citizen portal uses
# this only to turn a 6-digit postal code into a map location.
ONEMAP_API_TOKEN=
